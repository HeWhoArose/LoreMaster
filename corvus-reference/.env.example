# ---------------------------------------------------------------------------
# Corvus Story Engine — environment variables (all optional)
# ---------------------------------------------------------------------------
# Copy this file to .env and uncomment / change anything you want to override.
# All settings have sensible defaults — running with no .env at all works fine.
# ---------------------------------------------------------------------------

# Port the backend listens on.
# Default: 3000
# PORT=3000

# Host the backend binds to.
# Default: 127.0.0.1 (localhost only — safest for a local-first app)
# Set to 0.0.0.0 if you want to access Corvus from another device on your LAN.
# HOST=127.0.0.1

# Where Corvus stores game data, character cards, history, images, etc.
# Default: ~/corvus-data
# Use an absolute path. The directory will be created if it doesn't exist.
# CORVUS_DATA_DIR=/path/to/your/corvus-data

# ---------------------------------------------------------------------------
# Note: LM Studio URL, ComfyUI URL, model names, context window, etc. are all
# configured inside the app via the Settings panel — not via environment
# variables. They get persisted to <CORVUS_DATA_DIR>/config.json.
# ---------------------------------------------------------------------------
